generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = "5"
  interface            = "sync"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  score Int
  last_score DateTime @updatedAt
  scores Score[]
}

model Score {
  id Int @id @default(autoincrement())
  user User @relation(fields: [datetime], references: [id])
  datetime DateTime @default(now())
}